OPENAI_API_KEY=
SCOREY_MODEL=gpt-5-nano

# Optional per-model overrides. Leave blank to use provider defaults.
SCOREY_REASONING_EFFORT=
SCOREY_REASONING_SUMMARY=
SCOREY_VERBOSITY=
SCOREY_TOP_P=

# Source-linked principles. Build and pin an index before enabling.
SCOREY_MEMORY_ENABLED=false
SCOREY_MEMORY_DB=.local/memory.sqlite
SCOREY_MEMORY_INDEX=
SCOREY_MEMORY_EMBEDDING_MODEL=text-embedding-3-small
SCOREY_MEMORY_TOP_K=2
SCOREY_MEMORY_MAX_CHARS=1200
